#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <4>;
        map = <
        RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)
        RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)
        RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)
                                   RC(3,3)  RC(3,4)
        >;
    };
};

/delete-node/ &kscan0;

/ {
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 0
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 1
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 2
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // Row 3
            ;

        col-gpios
            = <&pro_micro 18 GPIO_ACTIVE_HIGH>  // Col 0
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>  // Col 1
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>  // Col 2
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>  // Col 3
            , <&pro_micro 10 GPIO_ACTIVE_HIGH>  // Col 4
            ;
    };
};